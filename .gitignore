# Parse screenshots written by 60s Parse Mode — yours, not the project's.
parses/
failles/

# Every encounter combat history has saved. Yours, and there can be thousands
# of them — a source run writes here rather than to %LOCALAPPDATA%. The meter
# never deletes from this folder, so it is the one place in the project that
# grows without bound; empty it yourself when you want the space.
history/

# Byte-compiled cache. Regenerated on every run, and a binary blob in every
# diff if it's tracked.
__pycache__/
*.pyc

# Where you dragged the overlay windows, and which options you picked. Both are
# per-machine and rewritten constantly.
.meter_position.json
.meter_settings.json

# Your fastest boss kills. Records, not configuration — and personal either way.
.meter_besttimes.json

# Your own additions to the sound pools. The shipped defaults live in
# assets/victory and assets/codex and ARE tracked; this is the folder the meter
# also reads so that what you add survives an update. Yours, not the project's.
sounds/

# A codex probe's dump of one character's kill counts. Yours, and a measurement
# artifact rather than data the meter needs — it regenerates whenever the probe
# runs. (analysis_out/codex_units.json IS tracked: that one is derived from the
# game's data.cdb, same as the offsets beside it.)
analysis_out/codex_progress_dump.json

# Release build output from packaging/build.ps1 — a few hundred megabytes of
# regenerated bundle. The installer it produces belongs on a GitHub release,
# not in the repo. (assets/farevermeter.ico IS tracked: a from-source run wants
# the tray icon without needing Pillow to draw it first.)
/build/
/dist/

# The engineering notebook — how the game was measured, which probes proved
# what, and the field names that mean the opposite of what they say. Kept
# locally and deliberately not published: it was purged from the history
# rather than merely deleted, so an ignore rule is what keeps it from being
# committed back by accident.
/TESTING.md

# Dungeon runs recorded by the meter. Yours, not the project's.
donjons/
builds/
analysis_out/item_icons/
analysis_out/boss_portraits/
analysis_out/collection_img/
.meter_collection.json
analysis_out/bestiary_img/
.meter_codex.json
analysis_out/map_tiles/
.meter_elements.json
analysis_out/skill_img/
.meter_itemcodex.json
.meter_achievements.json
.meter_goals.json
